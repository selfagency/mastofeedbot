{
  "name": "@selfagency/mastofeedbot",
  "version": "0.2.0",
  "description": "A bot to syndicate RSS to Mastodon via GitHub Actions",
  "keywords": [
    "mastodon",
    "fediverse",
    "bot",
    "rss"
  ],
  "homepage": "https://github.com/selfagency/mastofeedbot#readme",
  "bugs": {
    "url": "https://github.com/selfagency/mastofeedbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfagency/mastofeedbot.git"
  },
  "license": "MIT",
  "author": "Daniel Sieradski <daniel@self.agency>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node esbuild.js",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@extractus/feed-extractor": "^8.0.4",
    "masto": "^8.0.1",
    "mkdirp": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy-file": "^0.0.2",
    "esbuild-plugin-fileloc": "^0.0.6",
    "fallow": "^3.50.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.3.1",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24.15.0"
  }
